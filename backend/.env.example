# Copie para .env (que está no .gitignore) e preencha. Nunca versione o .env.
# Variáveis de ambiente têm prioridade sobre este arquivo.

# --- Banco de dados (PostgreSQL) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=gestao-db
POSTGRES_USER=
POSTGRES_PASSWORD=
# Opcional: URL completa. Se preenchida, tem prioridade sobre as variáveis acima.
# Ex.: postgresql+psycopg://usuario:senha@localhost:5432/gestao-db
DATABASE_URL=
# Windows: pasta com a libpq.dll do PostgreSQL. Vazio = detectar em
# C:/Program Files/PostgreSQL/<versão>/bin (necessário com o Smart App Control ligado).
POSTGRES_BIN_DIR=

# --- OCR (Nota Fiscal) ---
# Caminho do executável; deixe vazio se o tesseract estiver no PATH (ex.: no Docker).
TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
OCR_IDIOMA=eng
OCR_ZOOM=2.0

# --- Armazenamento dos PDFs enviados (um arquivo por conteúdo, nome = hash) ---
STORAGE_DIR=./storage
TAMANHO_MAXIMO_ARQUIVO_MB=25

# --- Pastas organizadas (Documentos Verificados, Documentos Mesclados, relatório .xlsx) ---
# Pode ser uma pasta sincronizada com a nuvem, ex.: C:/Users/<você>/OneDrive/Gestao de Clientes
PASTA_DOCUMENTOS=../documentos_organizados

# --- API ---
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
ARQUIVO_LOG=./logs/app.log
